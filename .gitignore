!/results/model_probe_check.json
!/results/wrong_top1_audit.json
# Revision R1/R2 (2026-10-13): B value from library CIFs (a number + counts) and rescoring summaries (ranks, no structures).
!/results/r2_bvalue.json
!/results/rescore_*.json
!/results/strong_baselines_v2.json
!/results/strong_baselines_v2.png
