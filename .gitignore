# --- CSD licence guard: NEVER commit structure data ---
# The CSD licence does not permit redistribution of deposited structures.
# Ship refcode lists + configs only; licence holders regenerate from those.
*.cif
*.cif.gz
*.gcd
*.res
*.mol2
*.sdf
# Anchor these to the repo ROOT (leading slash) so they block top-level data dirs WITHOUT also
# matching the source package src/xrdclip/data/ — an un-anchored `data/` silently swallowed the
# entire pipeline source once already.
/data/
/structures/
# cache/ holds the stage-1 jsonl.gz shards, which contain CSD-derived CIF TEXT inside them.
# The *.cif rule does NOT catch CIFs embedded in a .gz, so the whole cache is blocked explicitly.
/cache/
/runs/
# R5 open stand-in: COD CIFs, shards and simulated sticks (CC0, but large; released on Zenodo, not in git)
/cod/
# Block results/ wholesale, EXCEPT the headline metrics + figure: these are aggregate retrieval
# numbers and a matplotlib line-plot only — no coordinates, no refcodes — so they are safe to track.
/results/*
# v2 Phase 0 / Gate G0 (2026-10-10): aggregate metrics + figure + table only (ranks .npz stay ignored).
!/results/strong_baselines.json
!/results/strong_baselines.png
!/results/g0_table.md
!/results/real_eval_table.md
!/results/real_eval_2k.json
# Real benchmark v2 (2026-10-11): aggregate metrics + per-query ids/stems/ranks only (refcodes, no structures).
!/results/real_bench.json
!/results/real_bench_table.md
# Hubness pass (2026-10-12): same kind of aggregate metrics + hub refcodes/counts.
!/results/real_bench_hub.json
!/results/real_bench_hub_table.md
# Paper numbers + ZZZUWK case study (2026-10-12): aggregate metrics, scores and peak heights; refcodes, no structures.
!/results/paper_numbers.json
!/results/case_zzzuwk.json
!/results/polymorph.json
!/results/polymorph.png
!/results/combined.json
!/results/combined.png
# Ablation results (2026-07-18): same aggregate-metrics + line-plot content, safe to track.
!/results/polymorph_noshift.json
!/results/polymorph_noshift.png
!/results/combined_noshift.json
!/results/combined_noshift.png
!/results/polymorph_noaug.json
!/results/polymorph_noaug.png
!/results/combined_noaug.json
!/results/combined_noaug.png
# Real-pattern sim-to-real check (2026-08-04): ranks/nearest-neighbours over public refcodes only
# (no CSD coordinates/CIF content) -- consistent with refcodes/*.txt already being tracked.
!/results/real_pattern_eval.json
# Local pre-pivot splits safety copy — already recoverable from git history (commit 786cdca).
/refcodes/_pre_polymorph_backup/
!refcodes/
!refcodes/*.txt

# Derived artifacts
*.npz
*.npy
*.pt
*.ckpt
checkpoints/
runs/
wandb/
outputs/

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.ipynb_checkpoints/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# LaTeX build aux (keep .tex/.bib/.pdf, drop intermediates)
paper/*.aux
paper/*.log
paper/*.blg
paper/*.bbl
paper/*.out
paper/*.synctex.gz
